{
  "PSX": {
    "api": { ".read": true, ".write": false },
    "reference": { ".read": true, ".write": false },
    "syncStatus": { ".read": true, ".write": false },
    "requests": {
      ".read": "auth != null",
      ".indexOn": ["requestedAt"],
      "$key": {
        ".write": "auth != null && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['path', 'requestedAt'])",
        "path": { ".validate": "newData.isString() && newData.val().length <= 190" },
        "requestedAt": { ".validate": "newData.isNumber() && newData.val() == now" },
        "$other": { ".validate": false }
      }
    }
  }
}
